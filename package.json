{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .netlify",
    "test:coordinator": "node --test tests/claude-coordinator.unit.test.mjs tests/claude-coordinator.integration.test.mjs",
    "claude:run": "node scripts/claude-coordinator.mjs run",
    "claude:status": "node scripts/claude-coordinator.mjs status",
    "claude:list": "node scripts/claude-coordinator.mjs list",
    "claude:cleanup": "node scripts/claude-coordinator.mjs cleanup",
    "db:generate": "drizzle-kit generate",
    "db:price-check:generate": "drizzle-kit generate --config=drizzle.price-check.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-presigned-post": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@netlify/database": "1.1.0",
    "drizzle-orm": "1.0.0-beta.22",
    "jose": "^6.2.9",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@netlify/database-dev": "0.10.1",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "1.0.0-beta.22",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "nitro": "^3.0.260610-beta",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "ws": "8.21.0"
  },
  "type": "module"
}
