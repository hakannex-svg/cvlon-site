# Approved production origin used for canonical URLs, structured data, sitemap
# URLs, and the robots sitemap reference. Keep this value for staging too;
# staging remains noindex through NEXT_PUBLIC_ALLOW_INDEXING below.
NEXT_PUBLIC_SITE_URL=https://cvlon.com

# Keep false for local, branch-preview, deploy-preview, and staging builds.
# Set true only after explicit production indexing approval.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Keep the Price Check unavailable by default. Enable only on the approved
# Phase 3 Deploy Preview branch until the product receives production approval.
NEXT_PUBLIC_PRICE_CHECK_ENABLED=false
PRICE_CHECK_BOOTSTRAP_ADMIN_EMAILS=

# Phase 7 document uploads are server-only and must remain unset in production
# until a separately approved production bucket and workload identity exist.
PRICE_CHECK_UPLOAD_AWS_REGION=
PRICE_CHECK_UPLOAD_AWS_ACCESS_KEY_ID=
PRICE_CHECK_UPLOAD_AWS_SECRET_ACCESS_KEY=
PRICE_CHECK_UPLOAD_BUCKET=

# Phase 8 document extraction is server-only, explicitly staff-triggered, and
# limited to the approved Phase 8 Deploy Preview branch. Keep all values unset
# in production. Never expose the key through a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=
OPENAI_EXTRACTION_SCHEMA_VERSION=phase8-v1
OPENAI_EXTRACTION_PROMPT_VERSION=phase8-v2

# Phase 9 customer-explanation drafting is independently configurable. It is
# preview-only, admin-triggered, server-side, and never receives documents,
# prices, observations, requester data, supplier data, or free-form notes.
OPENAI_EXPLANATION_MODEL=
OPENAI_EXPLANATION_SCHEMA_VERSION=phase9-v1
OPENAI_EXPLANATION_PROMPT_VERSION=phase9-v1

# Netlify Forms uses the built-in form POST endpoint. No secret or client-side
# delivery token is required. Delivery must be verified on a real deploy preview.

# The analytics bridge has no environment variable and sends only approved event
# names plus source_page, aircraft_brand, and part_category—not form-field values.

# Form submission is enabled only when the browser hostname ends in .netlify.app.
# There is no host-allowlist environment variable in this release.

# Buy & Sell intake is gated independently of the Price Check flag so neither
# workflow can be exposed as a side effect of enabling the other. Keep false
# everywhere until the marketplace receives its own production approval.
NEXT_PUBLIC_MARKETPLACE_ENABLED=false

# Sell intake carries a second switch on top of the marketplace flag: both must
# be true for the Sell endpoints to answer. Sell is deliberately narrower than
# Buy today (no supplier-facing page, no evidence uploads), so Buy can ship
# while Sell stays dark, and Sell alone can be closed without touching Buy.
NEXT_PUBLIC_SELL_SUBMISSIONS_ENABLED=false

# Server-only key for Buy/Sell email-verification tokens. Minimum 32 characters.
# Only a keyed hash and a derivation nonce are stored; rotating this key
# immediately invalidates every outstanding verification link.
MARKETPLACE_VERIFY_TOKEN_KEY=

# Approved marketplace sender and internal routing. Both are optional: blank
# uses the approved defaults (Civilon Parts <parts@cvlon.com>, and
# sales@cvlon.com / hakan@shipnex.com / david@cvlon.com). A supplied but
# unusable value fails closed rather than delivering somewhere unintended.
MARKETPLACE_EMAIL_FROM=
MARKETPLACE_INTERNAL_RECIPIENTS=

# Server-only key for marketplace upload-session ownership. Minimum 32
# characters, and deliberately not the Price Check upload secret: only a keyed
# HMAC of the browser cookie is stored, so a database reader cannot recompute a
# session hash, and a Price Check cookie hashes to nothing on this side.
# Unset means marketplace uploads are unavailable, which is the correct state
# until the marketplace bucket exists.
MARKETPLACE_UPLOAD_SESSION_KEY=

# Marketplace-private evidence storage. Separate bucket configuration from
# PRICE_CHECK_UPLOAD_*: there is no fallback to the Price Check bucket, because
# inheriting it would place supplier evidence under a policy, lifecycle and
# GuardDuty prefix approved for a different workload. Objects live only under
# the marketplace/ prefix, stay private and quarantined, and are never public.
# Leave every value blank in production until the bucket is approved and
# provisioned; blank disables marketplace uploads and intake still works.
MARKETPLACE_UPLOAD_AWS_REGION=
MARKETPLACE_UPLOAD_AWS_ACCESS_KEY_ID=
MARKETPLACE_UPLOAD_AWS_SECRET_ACCESS_KEY=
MARKETPLACE_UPLOAD_BUCKET=

# Preview-only manual drain of the marketplace notification outbox.
#
# The production schedule never runs in a non-production Netlify context, which
# is correct but leaves a controlled preview unable to prove that Buy/Sell
# verification mail and the internal notice actually send. Setting this to the
# literal "true" opens POST /api/admin/marketplace/notifications/process for
# signed-in ADMIN staff only, and only when NEXT_PUBLIC_MARKETPLACE_ENABLED is
# true and this deploy can be proved not to be production — see
# MARKETPLACE_PREVIEW_ORIGIN below.
#
# Keep it false, blank, or unset everywhere else. It sends real email; it is not
# a load test, and it processes at most 10 messages per call.
MARKETPLACE_PREVIEW_NOTIFICATIONS_ENABLED=false

# The explicit address of a controlled preview deploy, e.g.
# https://deploy-preview-20--cvlon.netlify.app
#
# Netlify's serverless runtime does not expose the build-only read-only
# variables: CONTEXT, DEPLOY_PRIME_URL and DEPLOY_URL exist during a build but
# not inside a function. Only URL, SITE_NAME and SITE_ID are read-only variables
# at request time, and URL is the production site address even inside a deploy
# preview. So a function cannot ask Netlify which deploy it is; it must be told.
#
# Set this ONLY as a branch-scoped variable on a preview branch, never on the
# production context. It does two things: marketplace verification and admin
# links are built against it instead of production, and it is the proof of
# non-production that the manual drain requires when CONTEXT is unavailable.
#
# It must be https and a canonical Civilon Deploy Preview host
# (deploy-preview-<number>--cvlon.netlify.app). cvlon.com, the bare
# cvlon.netlify.app alias, branch-deploy aliases, another tenant's Netlify site,
# and anything unparseable are rejected, so a stray value cannot open the drain.
MARKETPLACE_PREVIEW_ORIGIN=
